adapt --format rubocop
# This configuration was generated by
# `rubocop --auto-gen-config`

# Offense count: 3
Layout/LineLength:
  Max: 140
  Exclude:
    - 'app/models/user.rb'
    - "app/models/order.rb"
    - lib/tasks/import.rake

# Offense count: 40
Style/Documentation:
  Enabled: false

