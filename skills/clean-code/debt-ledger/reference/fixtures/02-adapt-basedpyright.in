adapt --format basedpyright
{
    "files": {
        "pkg/mod.py": [
            {
                "code": "reportUnknownMemberType",
                "range": {
                    "startColumn": 4,
                    "endColumn": 9,
                    "lineCount": 1
                }
            },
            {
                "code": "reportAny",
                "range": {
                    "startColumn": 0,
                    "endColumn": 3,
                    "lineCount": 1
                }
            },
            {
                "code": "reportUnknownMemberType",
                "range": {
                    "startColumn": 2,
                    "endColumn": 5,
                    "lineCount": 1
                }
            }
        ],
        "pkg/empty.py": []
    }
}
